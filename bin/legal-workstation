#!/usr/bin/env bash
# legal-workstation - Legal Workstation CLI & Diagnostic Tool
# Repository: https://github.com/AenuHub/linux-legal-workstation

set -euo pipefail

# Find script directory
DIR_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$DIR_ROOT/lib/common.sh" 2>/dev/null || {
    # Fallback if installed standalone in ~/.local/bin
    RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'
    log_info() { printf "${BLUE}[INFO]${NC} %s\n" "$*"; }
    log_success() { printf "${GREEN}[BAŞARILI]${NC} %s\n" "$*"; }
    log_warn() { printf "${YELLOW}[UYARI]${NC} %s\n" "$*"; }
    log_error() { printf "${RED}[HATA]${NC} %s\n" "$*" >&2; }
    log_step() { printf "\n${BOLD}${CYAN}==>${NC} ${BOLD}%s${NC}\n" "$*"; }
    has_cmd() { command -v "$1" >/dev/null 2>&1; }
}

cmd_doctor() {
    printf "${BOLD}=====================================================${NC}\n"
    printf "${BOLD}  Legal Workstation - Teşhis ve Sağlık Kontrolü${NC}\n"
    printf "${BOLD}=====================================================${NC}\n\n"

    local all_ok=true

    if [[ "$(uname -s)" == "Darwin" ]]; then
        # 1. macOS Smart Card Subsystem
        printf "%-35s" "1. Akıllı Kart Altyapısı:"
        printf "${GREEN}[ÇALIŞIYOR]${NC} (macOS CryptoTokenKit)\n"

        # 2. Smart Card Reader
        printf "%-35s" "2. Kart Okuyucu / USB Token:"
        local readers_mac=""
        if has_cmd system_profiler; then
            readers_mac=$(system_profiler SPSmartCardsDataType 2>/dev/null | grep -i "Reader:" | head -n 1 | awk -F': ' '{print $2}' || true)
        fi
        if [[ -n "$readers_mac" ]]; then
            printf "${GREEN}[ALGILANDI]${NC} (%s)\n" "$readers_mac"
        else
            printf "${YELLOW}[KART OKUYUCU TAKILI DEĞİL]${NC} (Lütfen e-imza USB token'ınızı takın)\n"
        fi

        # 3. Adalet E-İmza Tray
        printf "%-35s" "3. Adalet E-İmza Servisi:"
        if pgrep -f "adalet-eimza-tray" >/dev/null 2>&1; then
            printf "${GREEN}[ÇALIŞIYOR]${NC}\n"
        elif [[ -d "/Applications/Adalet E-İmza Tray.app" ]]; then
            printf "${YELLOW}[KAPALI]${NC} -> 'open -a \"/Applications/Adalet E-İmza Tray.app\"'\n"
        else
            printf "${RED}[YOK]${NC} -> Adalet E-İmza kurulu değil.\n"
            all_ok=false
        fi

        # 4. Java Runtime
        printf "%-35s" "4. UYAP Uyumlu Java:"
        if [[ -x "/Applications/UyapDokumanEditoru.app/Contents/runtime/bin/java" ]]; then
            printf "${GREEN}[MEVCUT]${NC} (UYAP Dahili Gömülü JRE)\n"
        elif has_cmd java; then
            printf "${GREEN}[MEVCUT]${NC} (%s)\n" "$(java -version 2>&1 | head -n 1)"
        else
            printf "${GREEN}[MEVCUT]${NC} (UYAP Paketine Dahil)\n"
        fi

        # 5. UYAP Editor
        printf "%-35s" "5. UYAP Doküman Editörü:"
        if [[ -d "/Applications/UyapDokumanEditoru.app" || -d "$HOME/Applications/UyapDokumanEditoru.app" ]]; then
            printf "${GREEN}[HAZIR]${NC} (/Applications/UyapDokumanEditoru.app)\n"
        else
            printf "${RED}[YOK]${NC} -> UYAP Editörü kurulu değil.\n"
            all_ok=false
        fi
    else
        # 1. PCSC Daemon
        printf "%-35s" "1. Akıllı Kart Servisi (pcscd):"
        if systemctl is-active --quiet pcscd.socket 2>/dev/null || systemctl is-active --quiet pcscd 2>/dev/null; then
            printf "${GREEN}[ÇALIŞIYOR]${NC}\n"
        else
            printf "${RED}[DURDURULMUŞ]${NC} -> 'sudo systemctl start pcscd'\n"
            all_ok=false
        fi

    # 2. Card Reader & Token check
    printf "%-35s" "2. Kart Okuyucu / USB Token:"
    if has_cmd opensc-tool; then
        local readers
        readers=$(opensc-tool --list-readers 2>/dev/null || true)
        if [[ -n "$readers" ]] && ! echo "$readers" | grep -qi "No smart card readers found"; then
            local card_name
            card_name=$(echo "$readers" | grep -E '^[0-9]' | head -n 1 | awk '{$1=$2=""; print $0}' | sed 's/^[ \t]*//')
            printf "${GREEN}[ALGILANDI]${NC} (%s)\n" "${card_name:-Kart Okuyucu}"
        else
            printf "${YELLOW}[KART OKUYUCU TAKILI DEĞİL]${NC} (Lütfen e-imza USB token'ınızı takın)\n"
        fi
    else
        printf "${YELLOW}[opensc-tool bulunamadı]${NC}\n"
    fi

    # 3. Adalet E-İmza Tray Service
    printf "%-35s" "3. Adalet E-İmza Servisi:"
    if systemctl --user is-active --quiet adalet-eimza-tray.service 2>/dev/null; then
        printf "${GREEN}[ÇALIŞIYOR]${NC}\n"
    else
        printf "${YELLOW}[KAPALI]${NC} -> 'systemctl --user start adalet-eimza-tray'\n"
    fi

    # 4. Java Runtime for UYAP
    printf "%-35s" "4. UYAP Uyumlu Java (8/11):"
    local java_found=false
    for jpath in \
        "$HOME/.local/share/jvm/temurin-11/bin/java" \
        /usr/lib/jvm/java-11-*/bin/java \
        /usr/lib/jvm/java-8-*/bin/java \
        /usr/lib/jvm/java-1.8.0-openjdk/bin/java \
        /usr/lib/jvm/java-11-openjdk*/bin/java \
        /usr/lib/jvm/java-11-*/jre/bin/java \
        /usr/bin/java; do
        if [[ -x "$jpath" ]]; then
            local jver
            jver=$("$jpath" -version 2>&1 | head -n 1)
            if echo "$jver" | grep -qE '(11\.|1\.8\.)'; then
                java_found=true
                printf "${GREEN}[MEVCUT]${NC} (%s)\n" "$jver"
                break
            fi
        fi
    done
    if [[ "$java_found" != true ]]; then
        printf "${RED}[BULUNAMADI]${NC} -> UYAP Editör için Java 11 JRE gereklidir.\n"
        all_ok=false
    fi

    # 5. UYAP Editor launcher
    printf "%-35s" "5. UYAP Doküman Editörü:"
    if has_cmd uyap-dokuman || [[ -x "$HOME/.local/bin/uyap-dokuman" ]]; then
        printf "${GREEN}[HAZIR]${NC}\n"
    else
        printf "${RED}[YOK]${NC} -> UYAP Editörü kurulu değil.\n"
        all_ok=false
    fi
    fi

    # 6. PTT UETS E-İmza İstemcisi
    printf "%-35s" "6. PTT UETS E-İmza İstemcisi:"
    if [[ -f /opt/uets/uets-eimza.jar || -x /usr/local/bin/uets-eimza || -d "/Applications/PTT UETS E-İmza.app" ]]; then
        printf "${GREEN}[HAZIR]${NC}\n"
    else
        printf "${YELLOW}[YOK]${NC} -> PTT UETS istemcisi kurulu değil.\n"
    fi

    # 7. Akıllı Kart & PIN Yönetimi (AKİA / Palma)
    printf "%-35s" "7. E-İmza PIN & Kart (AKİA):"
    if has_cmd akia || [[ -x /usr/local/bin/akia || -x /opt/Akia/Akia || -x /opt/Akia/akia || -x "$HOME/.local/bin/akia" || -d "/Applications/Akia.app" ]]; then
        printf "${GREEN}[HAZIR]${NC}\n"
    else
        printf "${YELLOW}[YOK]${NC} -> AKİA kart yönetim aracı kurulu değil.\n"
    fi

    printf "\n"
    if [[ "$all_ok" == true ]]; then
        printf "${GREEN}${BOLD}✔ Sisteminiz UYAP ve E-İmza kullanımı için hazırdır!${NC}\n"
    else
        printf "${YELLOW}${BOLD}⚠ Bazı bileşenlerde eksikler tespit edildi. 'install.sh' çalıştırarak düzeltebilirsiniz.${NC}\n"
    fi
}


cmd_upgrade() {
    log_step "Legal Workstation - Hukuk Paketi Güncelleniyor..."

    # 1. Self-update CLI and scripts
    log_info "1/4: Hukuk çalışma istasyonu betikleri kontrol ediliyor..."
    if [[ -d "$DIR_ROOT/.git" ]] && has_cmd git; then
        log_info "Git deposundan son güncellemeler alınıyor..."
        git -C "$DIR_ROOT" pull --ff-only 2>/dev/null || log_warn "Git deposu güncellenemedi, yerel sürümle devam ediliyor."
    else
        log_info "legal-workstation CLI son sürümü kontrol ediliyor..."
        curl -sSL "https://raw.githubusercontent.com/AenuHub/linux-legal-workstation/main/bin/legal-workstation" -o "$HOME/.local/bin/legal-workstation" 2>/dev/null && chmod +x "$HOME/.local/bin/legal-workstation" || true
    fi

    # 2. Adalet E-İmza Uygulaması CDN check & update
    log_info "2/4: Adalet E-İmza (Avukat Portal Girişi) CDN güncellemesi sorgulanıyor..."
    if [[ -x "$HOME/.local/bin/check-adalet-eimza-update" ]]; then
        "$HOME/.local/bin/check-adalet-eimza-update" || log_warn "Adalet E-İmza güncellemesi atlandı."
    fi

    # 3. UYAP Doküman Editörü Check & Update
    log_info "3/4: UYAP Doküman Editörü kontrol ediliyor..."
    if has_cmd yay; then
        yay -S --needed --noconfirm uyap-editor 2>/dev/null || log_info "UYAP Editörü zaten güncel."
    elif has_cmd paru; then
        paru -S --needed --noconfirm uyap-editor 2>/dev/null || log_info "UYAP Editörü zaten güncel."
    else
        log_info "UYAP Doküman Editörü kütüphaneleri kontrol edildi."
    fi

    # 4. Service restarts
    log_info "4/4: Arka plan servisleri yenileniyor..."
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user restart adalet-eimza-tray.service 2>/dev/null || true

    log_success "Tüm paket ve servis güncellemeleri tamamlandı!"
    printf "\n"
    cmd_doctor
}

cmd_uninstall() {
    local force=false
    if [[ "${2:-}" == "-y" || "${2:-}" == "--yes" ]]; then
        force=true
    fi

    if [[ "$force" != true ]]; then
        printf "${YELLOW}${BOLD}DİKKAT:${NC} Bu işlem Legal Workstation tarafından kurulan servisleri, başlatıcıları ve dosyaları sisteminizden kaldıracaktır.\n"
        printf "Daha önce sisteminizde manuel olarak kurulu olan genel sistem paketlerinize (kart okuyucu, sistem java vb.) dokunulmayacak şekilde temizlik yapılır.\n\n"
        read -r -p "Kaldırma işlemine devam etmek istiyor musunuz? [e/H] " confirm
        if [[ "$confirm" != "e" && "$confirm" != "E" && "$confirm" != "y" && "$confirm" != "Y" ]]; then
            log_info "Kaldırma işlemi iptal edildi."
            exit 0
        fi
    fi

    if [[ "$(uname -s)" == "Darwin" ]]; then
        log_step "macOS Legal Workstation kaldırılıyor..."

        log_info "1/3: Çalışan süreçler ve başlangıç öğeleri temizleniyor..."
        pkill -f "adalet-eimza-tray" 2>/dev/null || true
        osascript -e 'tell application "System Events" to delete login item "Adalet E-İmza Tray"' 2>/dev/null || true

        log_info "2/3: Uygulamalar kaldırılıyor..."
        sudo rm -rf "/Applications/Adalet E-İmza Tray.app" 2>/dev/null || true
        sudo rm -rf "/Applications/UyapDokumanEditoru.app" 2>/dev/null || true
        sudo rm -rf "/Applications/PTT UETS E-İmza.app" /opt/uets /usr/local/bin/uets-eimza 2>/dev/null || true

        log_info "3/3: legal-workstation CLI aracı kaldırılıyor..."
        sudo rm -f "/usr/local/bin/legal-workstation" "$HOME/.local/bin/legal-workstation" 2>/dev/null || true

        log_success "macOS Legal Workstation başarıyla kaldırıldı. Sisteminiz temizlendi."
        return 0
    fi

    log_step "Hukuk Çalışma İstasyonu kaldırılıyor..."

    # 1. Stop and disable Adalet E-İmza tray service
    log_info "1/4: Arka plan servisleri durduruluyor ve temizleniyor..."
    if has_cmd systemctl; then
        systemctl --user stop adalet-eimza-tray.service 2>/dev/null || true
        systemctl --user disable adalet-eimza-tray.service 2>/dev/null || true
    fi
    rm -f "$HOME/.config/systemd/user/adalet-eimza-tray.service"
    if has_cmd systemctl; then
        systemctl --user daemon-reload 2>/dev/null || true
    fi

    # 2. Remove desktop entries and launchers created by suite
    log_info "2/4: Masaüstü kısayolları ve başlatıcılar kaldırılıyor..."
    rm -f "$HOME/.local/share/applications/tr.gov.adalet.eimza-tray.desktop"
    rm -f "$HOME/.local/share/applications/uyap-dokuman.desktop"
    rm -f "$HOME/.local/share/applications/uets.desktop"
    rm -f "$HOME/.local/share/icons/adalet-eimza-tray."* 2>/dev/null || true
    if [[ -w /usr/share/applications ]] || has_cmd sudo; then
        sudo rm -f "/usr/share/applications/uets.desktop" 2>/dev/null || true
    fi

    # 3. Remove suite-specific binaries and libraries
    log_info "3/4: Uygulama ve kütüphaneler temizleniyor..."
    rm -f "$HOME/.local/bin/uyap-dokuman"
    rm -f "$HOME/.local/bin/adalet-eimza-tray"
    rm -f "$HOME/.local/bin/check-adalet-eimza-update"
    rm -rf "$HOME/.local/lib/adalet-eimza-tray"
    rm -f "$HOME/.local/lib/libakisp11.so"
    rm -f "$HOME/.local/lib/libopensc-pkcs11.so"
    rm -f "$HOME/.local/lib/libappindicator3"* 2>/dev/null || true

    # Clean UETS if installed by suite
    if [[ -d /opt/uets || -f /usr/local/bin/uets-eimza ]]; then
        log_info "PTT UETS E-İmza istemcisi temizleniyor..."
        sudo rm -rf /opt/uets /usr/local/bin/uets-eimza 2>/dev/null || true
    fi

    # Remove isolated Temurin JRE if installed exclusively by suite
    if [[ -d "$HOME/.local/share/jvm/temurin-11" ]]; then
        log_info "İzole Temurin Java 11 JRE temizleniyor..."
        rm -rf "$HOME/.local/share/jvm/temurin-11"
    fi


    # 4. Remove CLI tool itself
    log_info "4/4: legal-workstation CLI aracı kaldırılıyor..."
    local self_bin="$HOME/.local/bin/legal-workstation"
    if [[ -f "$self_bin" ]]; then
        rm -f "$self_bin"
    fi

    log_success "Hukuk Çalışma İstasyonu başarıyla kaldırıldı. Sisteminiz temizlendi."
}

cmd_help() {
    cat << EOF
Legal Workstation CLI

Kullanım:
  legal-workstation [komut]

Komutlar:
  doctor       Sistemdeki e-imza, kart okuyucu, servisler ve UYAP durumunu teşhis eder.
  upgrade      Tüm araçları (Adalet E-İmza, UYAP Editör, servisler, CLI) tek komutla günceller.
  update       'upgrade' komutunun kısayoludur.
  uninstall    Kurulan servisleri, başlatıcıları ve çalışma ortamını sistemden güvenle kaldırır.
  start        Adalet E-İmza arka plan servisini başlatır.
  restart      Adalet E-İmza ve PC/SC servislerini yeniden başlatır.
  help         Bu yardım mesajını gösterir.
EOF
}

case "${1:-doctor}" in
    doctor)
        cmd_doctor
        ;;
    upgrade|update|update-all)
        cmd_upgrade
        ;;
    uninstall|remove)
        cmd_uninstall "$@"
        ;;
    start)
        systemctl --user start adalet-eimza-tray.service
        log_success "Adalet E-İmza servisi başlatıldı."
        ;;
    restart)
        systemctl --user restart adalet-eimza-tray.service
        log_success "Servis yeniden başlatıldı."
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        cmd_help
        exit 1
        ;;
esac
