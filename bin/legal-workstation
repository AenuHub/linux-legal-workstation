#!/usr/bin/env bash
# legal-workstation - Turkish Legal Workstation CLI & Diagnostic Tool
# Repository: https://github.com/AenuHub/linux-legal-workstation

set -euo pipefail

# Find script directory
DIR_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$DIR_ROOT/lib/common.sh" 2>/dev/null || {
    # Fallback if installed standalone in ~/.local/bin
    RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'
    log_info() { printf "${BLUE}[INFO]${NC} %s\n" "$*"; }
    log_success() { printf "${GREEN}[BAŞARILI]${NC} %s\n" "$*"; }
    log_warn() { printf "${YELLOW}[UYARI]${NC} %s\n" "$*"; }
    log_error() { printf "${RED}[HATA]${NC} %s\n" "$*" >&2; }
    log_step() { printf "\n${BOLD}${CYAN}==>${NC} ${BOLD}%s${NC}\n" "$*"; }
    has_cmd() { command -v "$1" >/dev/null 2>&1; }
}

cmd_doctor() {
    printf "${BOLD}=====================================================${NC}\n"
    printf "${BOLD}  Linux Legal Workstation - Teşhis ve Sağlık Kontrolü${NC}\n"
    printf "${BOLD}=====================================================${NC}\n\n"

    local all_ok=true

    # 1. PCSC Daemon
    printf "%-35s" "1. Akıllı Kart Servisi (pcscd):"
    if systemctl is-active --quiet pcscd.socket 2>/dev/null || systemctl is-active --quiet pcscd 2>/dev/null; then
        printf "${GREEN}[ÇALIŞIYOR]${NC}\n"
    else
        printf "${RED}[DURDURULMUŞ]${NC} -> 'sudo systemctl start pcscd'\n"
        all_ok=false
    fi

    # 2. Card Reader & Token check
    printf "%-35s" "2. Kart Okuyucu / USB Token:"
    if has_cmd opensc-tool; then
        local readers
        readers=$(opensc-tool --list-readers 2>/dev/null || true)
        if [[ -n "$readers" ]] && ! echo "$readers" | grep -qi "No smart card readers found"; then
            local card_name
            card_name=$(echo "$readers" | grep -E '^[0-9]' | head -n 1 | awk '{$1=$2=""; print $0}' | sed 's/^[ \t]*//')
            printf "${GREEN}[ALGILANDI]${NC} (%s)\n" "${card_name:-Kart Okuyucu}"
        else
            printf "${YELLOW}[KART OKUYUCU TAKILI DEĞİL]${NC} (Lütfen e-imza USB token'ınızı takın)\n"
        fi
    else
        printf "${YELLOW}[opensc-tool bulunamadı]${NC}\n"
    fi

    # 3. Adalet E-İmza Tray Service
    printf "%-35s" "3. Adalet E-İmza Servisi:"
    if systemctl --user is-active --quiet adalet-eimza-tray.service 2>/dev/null; then
        printf "${GREEN}[ÇALIŞIYOR]${NC}\n"
    else
        printf "${YELLOW}[KAPALI]${NC} -> 'systemctl --user start adalet-eimza-tray'\n"
    fi

    # 4. Java Runtime for UYAP
    printf "%-35s" "4. UYAP Uyumlu Java (8/11):"
    local java_found=false
    for jpath in \
        "$HOME/.local/share/jvm/temurin-11/bin/java" \
        /usr/lib/jvm/java-11-*/bin/java \
        /usr/lib/jvm/java-8-*/bin/java \
        /usr/lib/jvm/java-1.8.0-openjdk/bin/java \
        /usr/lib/jvm/java-11-openjdk*/bin/java \
        /usr/lib/jvm/java-11-*/jre/bin/java \
        /usr/bin/java; do
        if [[ -x "$jpath" ]]; then
            local jver
            jver=$("$jpath" -version 2>&1 | head -n 1)
            if echo "$jver" | grep -qE '(11\.|1\.8\.)'; then
                java_found=true
                printf "${GREEN}[MEVCUT]${NC} (%s)\n" "$jver"
                break
            fi
        fi
    done
    if [[ "$java_found" != true ]]; then
        printf "${RED}[BULUNAMADI]${NC} -> UYAP Editör için Java 11 JRE gereklidir.\n"
        all_ok=false
    fi

    # 5. UYAP Editor launcher
    printf "%-35s" "5. UYAP Doküman Editörü:"
    if has_cmd uyap-dokuman || [[ -x "$HOME/.local/bin/uyap-dokuman" ]]; then
        printf "${GREEN}[HAZIR]${NC}\n"
    else
        printf "${RED}[YOK]${NC} -> UYAP Editörü kurulu değil.\n"
        all_ok=false
    fi

    printf "\n"
    if [[ "$all_ok" == true ]]; then
        printf "${GREEN}${BOLD}✔ Sisteminiz UYAP ve E-İmza kullanımı için hazırdır!${NC}\n"
    else
        printf "${YELLOW}${BOLD}⚠ Bazı bileşenlerde eksikler tespit edildi. 'install.sh' çalıştırarak düzeltebilirsiniz.${NC}\n"
    fi
}

cmd_upgrade() {
    log_step "Linux Legal Workstation - Hukuk Paketi Güncelleniyor..."

    # 1. Self-update CLI and scripts
    log_info "1/4: Hukuk çalışma istasyonu betikleri kontrol ediliyor..."
    if [[ -d "$DIR_ROOT/.git" ]] && has_cmd git; then
        log_info "Git deposundan son güncellemeler alınıyor..."
        git -C "$DIR_ROOT" pull --ff-only 2>/dev/null || log_warn "Git deposu güncellenemedi, yerel sürümle devam ediliyor."
    else
        log_info "legal-workstation CLI son sürümü kontrol ediliyor..."
        curl -sSL "https://raw.githubusercontent.com/AenuHub/linux-legal-workstation/main/bin/legal-workstation" -o "$HOME/.local/bin/legal-workstation" 2>/dev/null && chmod +x "$HOME/.local/bin/legal-workstation" || true
    fi

    # 2. Adalet E-İmza Uygulaması CDN check & update
    log_info "2/4: Adalet E-İmza (Avukat Portal Girişi) CDN güncellemesi sorgulanıyor..."
    if [[ -x "$HOME/.local/bin/check-adalet-eimza-update" ]]; then
        "$HOME/.local/bin/check-adalet-eimza-update" || log_warn "Adalet E-İmza güncellemesi atlandı."
    fi

    # 3. UYAP Doküman Editörü Check & Update
    log_info "3/4: UYAP Doküman Editörü kontrol ediliyor..."
    if has_cmd yay; then
        yay -S --needed --noconfirm uyap-editor 2>/dev/null || log_info "UYAP Editörü zaten güncel."
    elif has_cmd paru; then
        paru -S --needed --noconfirm uyap-editor 2>/dev/null || log_info "UYAP Editörü zaten güncel."
    else
        log_info "UYAP Doküman Editörü kütüphaneleri kontrol edildi."
    fi

    # 4. Service restarts
    log_info "4/4: Arka plan servisleri yenileniyor..."
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user restart adalet-eimza-tray.service 2>/dev/null || true

    log_success "Tüm paket ve servis güncellemeleri tamamlandı!"
    printf "\n"
    cmd_doctor
}

cmd_help() {
    cat << EOF
Linux Legal Workstation CLI

Kullanım:
  legal-workstation [komut]

Komutlar:
  doctor       Sistemdeki e-imza, kart okuyucu, servisler ve UYAP durumunu teşhis eder.
  upgrade      Tüm araçları (Adalet E-İmza, UYAP Editör, servisler, CLI) tek komutla günceller.
  update       'upgrade' komutunun kısayoludur.
  start        Adalet E-İmza arka plan servisini başlatır.
  restart      Adalet E-İmza ve PC/SC servislerini yeniden başlatır.
  help         Bu yardım mesajını gösterir.
EOF
}

case "${1:-doctor}" in
    doctor)
        cmd_doctor
        ;;
    upgrade|update|update-all)
        cmd_upgrade
        ;;
    start)
        systemctl --user start adalet-eimza-tray.service
        log_success "Adalet E-İmza servisi başlatıldı."
        ;;
    restart)
        systemctl --user restart adalet-eimza-tray.service
        log_success "Servis yeniden başlatıldı."
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        cmd_help
        exit 1
        ;;
esac
